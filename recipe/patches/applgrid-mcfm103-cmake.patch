+# gridwrap.cxx is compiled UNCONDITIONALLY, not only when with_applgrid is ON.
+# It provides null-guarded no-op stubs for book_grid_/fill_grid_/write_grid_,
+# and nplotter.f / mcfm_exit.f call those unconditionally -- the calls are
+# compiled regardless of the runtime `creategrid` test. Gating the file on
+# with_applgrid breaks the DEFAULT build with
+#   mcfm_exit.f: undefined reference to `write_grid_'
+#   nplotter.f:  undefined reference to `fill_grid_'
+# When the bridge is not linked the function pointers stay null and the stubs
+# do nothing, which is exactly what the file was written for.
+target_sources(objlib PRIVATE src/User/gridwrap.cxx)
+
+if(${with_applgrid})
+    set_property(TARGET mcfm APPEND_STRING PROPERTY
+                 LINK_FLAGS " ${MCFMBRIDGE_LDFLAGS} -lstdc++ -Wl,--version-script=${CMAKE_SOURCE_DIR}/hide-hplog.map")
+    if(${with_library})
+        set_property(TARGET libmcfm APPEND_STRING PROPERTY
+                     LINK_FLAGS " ${MCFMBRIDGE_LDFLAGS} -lstdc++ -Wl,--version-script=${CMAKE_SOURCE_DIR}/hide-hplog.map")
+    endif()
+endif()
+
