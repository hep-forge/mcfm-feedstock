--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -126,6 +126,40 @@
 target_include_directories(objlib PRIVATE src/Inc .)
 target_include_directories(mcfm PRIVATE src/Inc .)
 
+# ---- APPLgrid bridge (optional; fixed order only) ---------------------------
+# Resummed contributions are never gridded: APPLgrid re-convolution assumes the
+# cross section is linear in the PDFs, and resummation is not.
+#
+# gridwrap.cxx is compiled UNCONDITIONALLY. It holds null-guarded no-op stubs
+# for book_grid_/fill_grid_/write_grid_, and nplotter.f / mcfm_exit.f call
+# those unconditionally. Gating it on with_applgrid breaks the DEFAULT build:
+#   mcfm_exit.f: undefined reference to `write_grid_'
+#   nplotter.f:  undefined reference to `fill_grid_'
+target_sources(objlib PRIVATE src/User/gridwrap.cxx)
+
+option(with_applgrid "Build with the APPLgrid bridge" OFF)
+if(${with_applgrid})
+    find_program(MCFMBRIDGE_CONFIG mcfmbridge-config)
+    if(NOT MCFMBRIDGE_CONFIG)
+        message(FATAL_ERROR "with_applgrid=ON but mcfmbridge-config not found in PATH")
+    endif()
+    execute_process(COMMAND ${MCFMBRIDGE_CONFIG} --ldflags
+                    OUTPUT_VARIABLE MCFMBRIDGE_LDFLAGS
+                    OUTPUT_STRIP_TRAILING_WHITESPACE)
+    # Keep the flags as ONE string appended to LINK_FLAGS. Handing them to
+    # target_link_libraries() makes CMake treat `-u setup_mcfmbridge` as `-u`
+    # plus a library `-lsetup_mcfmbridge`: the force-link never forms and the
+    # build SUCCEEDS with no APPLgrid in the binary.
+    #
+    # Only the mcfm EXECUTABLE links the bridge. libmcfm (with_library=ON) does
+    # not need it -- gridwrap's stubs no-op without it -- and it is created
+    # further down this file, so setting a property on it here would fail with
+    # "could not find TARGET libmcfm".
+    set_property(TARGET mcfm APPEND_STRING PROPERTY
+                 LINK_FLAGS " ${MCFMBRIDGE_LDFLAGS} -lstdc++ -Wl,--version-script=${CMAKE_SOURCE_DIR}/hide-hplog.map")
+    message(STATUS "APPLgrid bridge enabled: ${MCFMBRIDGE_LDFLAGS}")
+endif()
+
 ## MCFM as a library
 
 if(${with_library})
