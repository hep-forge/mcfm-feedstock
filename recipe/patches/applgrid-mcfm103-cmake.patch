+# libquadmath is x86-only: GCC builds it where __float128 is a distinct type,
+# which it is not on aarch64 (there long double already IS IEEE binary128, so
+# the quad arithmetic lives in libm under the long double names). Linking
+# -lquadmath therefore fails on aarch64 even though nothing needs its symbols.
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64|i686")
+  set(MCFM_QUADMATH quadmath)
+else()
+  set(MCFM_QUADMATH "")
+endif()
+
+# ---- APPLgrid bridge (optional) --------------------------------------------
+# Compiles the C++ hook shim and links mcfm-bridge, as the 6.8 build does.
+# gridwrap.cxx provides C-callable book_grid_/fill_grid_/write_grid_ stubs that
+# dispatch through function pointers the bridge installs at load time.
+# FIXED ORDER ONLY -- resummed contributions are never gridded, because
+# APPLgrid re-convolution assumes linearity in the PDFs and resummation is not.
+option(with_applgrid "Build with the APPLgrid bridge" OFF)
+if(${with_applgrid})
+    find_program(MCFMBRIDGE_CONFIG mcfmbridge-config)
+    if(NOT MCFMBRIDGE_CONFIG)
+        message(FATAL_ERROR "with_applgrid=ON but mcfmbridge-config not found in PATH")
+    endif()
+    execute_process(COMMAND ${MCFMBRIDGE_CONFIG} --ldflags
+                    OUTPUT_VARIABLE MCFMBRIDGE_LDFLAGS
+                    OUTPUT_STRIP_TRAILING_WHITESPACE)
+    # Do NOT separate_arguments() this into a list and hand it to
+    # target_link_libraries: CMake treats each element as a library name, so
+    # `-u setup_mcfmbridge` becomes `-u` followed by `-lsetup_mcfmbridge`, a
+    # library that does not exist. The force-link then never forms, nothing
+    # references the bridge, and the static archive contributes nothing --
+    # the build still succeeds but produces a binary with no APPLgrid in it.
+    # Keep it as ONE string and append it to the link flags instead.
+    add_compile_definitions(WITH_APPLGRID=1)
+    message(STATUS "APPLgrid bridge enabled: ${MCFMBRIDGE_LDFLAGS}")
+endif()
+
