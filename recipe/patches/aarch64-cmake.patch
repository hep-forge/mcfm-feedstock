+
+# libquadmath is x86-only: GCC builds it where __float128 is a distinct type,
+# which it is not on aarch64 -- there long double already IS IEEE binary128, so
+# the quad arithmetic lives in libm under the long double names. Linking
+# -lquadmath therefore fails on aarch64 even though nothing needs its symbols.
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64|i686")
+  set(MCFM_QUADMATH quadmath)
+else()
+  set(MCFM_QUADMATH "")
+endif()
 
