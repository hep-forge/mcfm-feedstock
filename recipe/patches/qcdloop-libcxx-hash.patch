 #include "qcdloop/cache.h"
 
 
+// libc++ (macOS) has no std::__hash_base / std::_Hash_impl, which are libstdc++
+// internals. These hashes only key the integral cache, so an FNV-1a hash of
+// the object bytes is an equivalent, portable replacement.
+template <typename T>
+inline std::size_t ql_bytes_hash(const T & v)
+{
+  const unsigned char * p = reinterpret_cast<const unsigned char *>(&v);
+  std::size_t h = 14695981039346656037ULL;
+  for (std::size_t i = 0; i < sizeof(T); ++i) { h ^= p[i]; h *= 1099511628211ULL; }
+  return h;
+}
+
