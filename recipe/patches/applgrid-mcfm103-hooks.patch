@@ -901,6 +925,22 @@
       if (currentPDF == 0) then
         lowint=flux*pswt*xmsq/BrnRat
         if (kewcorr /= knone) lowint_noew=flux*pswt*xmsq_noew/BrnRat
+c--- APPLgrid - publish the event: Bjorken x, factorization scale and the
+c--- overall weight, so the C++ side can fill the grid. contrib=100 marks a
+c--- Born (LO) contribution, matching the 6.8 bridge convention.
+        if (creategrid .and. ag_fill .and. bin) then
+           contrib      = 100
+           weightfactor = flux*pswt*wgt/BrnRat/ag_niter
+           ag_xx1       = xx(1)
+           ag_xx2       = xx(2)
+           ag_scale     = facscale
+c--- 6.8 uses val=lowint*wgt, refwt=val/itmx, refwt2=val**2/itmx. Note refwt2
+c--- is val SQUARED over niter, NOT refwt squared -- refwt*refwt would divide
+c--- by niter twice and understate the stored MC error.
+           refwt        = lowint*wgt/ag_niter
+           refwt2       = (lowint*wgt)**2/ag_niter
+        endif
+c--- APPLgrid - end
       endif
 
