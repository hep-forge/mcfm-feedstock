+      logical creategrid
+      integer nSubProcess
+      common/grid/creategrid,nSubProcess
+
+      double precision weightb( -nf:nf, -nf:nf)
+      double precision weightv( -nf:nf, -nf:nf)
+      double precision weightv1( -nf:nf, -nf:nf)
+      double precision weightv2( -nf:nf, -nf:nf)
+      double precision weightr( 0:maxd , -nf:nf, -nf:nf)
+      double precision weightfactor
+      common/gridweight/
+     .     weightfactor,
+     .     weightb,
+     .     weightv,weightv1,weightv2,
+     .     weightr
+      
+c--- APPLgrid - integration accounting. MCFM 10.3 NEVER assigns itmx or ncall
+c--- (the /bveg1int/ common in vegas_common.f is vestigial in 10.3), so the 6.8
+c--- normalisation "/dfloat(itmx)" divides by ZERO here and every stored weight
+c--- becomes NaN. 10.3 keeps the real counts in MCFMStorage: info%callsPerIt and
+c--- the per-call niter. These are set from integrate() -- as DOUBLES, so there
+c--- is no Fortran-integer-kind vs C-struct-padding ambiguity for the bridge.
+c---   ag_niter  : iterations in the CURRENT integrate() batch
+c---   ag_totcall: production calls accumulated so far (metadata for run())
+c---   ag_fill   : .true. only in production (stage >= 1). Warmup events must
+c---               NOT be filled or they contaminate the grid.
+c--- Deliberately NOT threadprivate: written once per batch on the master
+c--- thread, read-only inside the event loop (same reasoning as /grid/).
+      double precision ag_niter,ag_totcall
+      logical ag_fill
+      common/gridnorm/ag_niter,ag_totcall,ag_fill
+
+      integer contrib,dipole
+      double precision ag_xx1,ag_xx2,ag_x1z,ag_x2z,ag_scale,refwt,refwt2
+      common/gridevent/
+     .     ag_xx1,ag_xx2,ag_x1z,ag_x2z,
+     .     ag_scale,refwt,refwt2,
+     .     contrib,dipole
+      
+
+
+c--- APPLgrid - THREAD SAFETY.
+c--- MCFM 10.3 runs the fixed-order integrands under OpenMP, and 10.3 already
+c--- declares /nflav/ and /qcdcouple/ threadprivate for that reason. These grid
+c--- blocks accumulate PER EVENT, so without the same treatment every thread
+c--- would write the same weightb/gridevent storage and the weights would race.
+c--- NOTE /grid/ is deliberately NOT threadprivate: creategrid is read-only
+c--- configuration, set once on the master thread by parseinput. Making it
+c--- threadprivate would give worker threads an uninitialised (false) copy and
+c--- no grid would ever be filled. Only the per-event accumulators below need
+c--- thread-private storage.
+!$omp threadprivate(/gridweight/)
+!$omp threadprivate(/gridevent/)
--- a/src/User/gridwrap.cxx
+++ b/src/User/gridwrap.cxx
@@ -0,0 +1,39 @@
+//
+//   @file    new_gridwrap.cxx         
+//   
+//
+//   @author M.Sutton
+// 
+//   Copyright (C) 2013 M.Sutton (sutt@cern.ch)    
+//
+//   $Id: new_gridwrap.cxx, v0.0   Thu 18 Jul 2013 20:24:29 CEST sutt $
+
+//namespace mcfm_bridge { 
+
+static const int mxpart = 14;    // MCFM 10.3 src/Inc/mxpart.f (6.8 constants.f also has 14).
+                                 // MUST match mcfm_interface.cxx or fill_gridptr is
+                                 // declared with two different types across TUs (ODR/UB).
+
+/// function pointer hooks - set to 0 when no functions defined and applgrid not linked
+void (*book_gridptr)()                            = 0;
+void (*fill_gridptr)(const double evt[][mxpart])  = 0;
+void (*write_gridptr)(double& )                   = 0;
+
+//}
+
+/// mcfm user hooks - do nothing if external function pointers are not assigned
+
+/// book grids
+extern "C" void  book_grid_()  {  if ( book_gridptr ) book_gridptr(); }
+extern "C" void  book_grid__() {  book_grid_(); }
+
+/// fill grids
+extern "C" void  fill_grid_(const double evt[][mxpart])     {   if ( fill_gridptr ) fill_gridptr(evt); }
+extern "C" void  fill_grid__(const double evt[][mxpart])    {   fill_grid_(evt); }
+
+/// write grids
+extern "C" void  write_grid_(double& xstotal)      { if ( write_gridptr ) write_gridptr(xstotal); }
+extern "C" void  write_grid__(double& xstotal)     { write_grid_(xstotal); }
+
+
